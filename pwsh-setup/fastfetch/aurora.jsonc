{
  // fastfetch 精简配置（Aurora 风格，随 PowerShell 启动显示一次）
  // 手动查看：ff 或 fastfetch --config ~/.config/fastfetch/aurora.jsonc
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "Windows 11_small",
    "padding": {
      "top": 1,
      "left": 3,
      "right": 3
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "shell",
    "terminal",
    "uptime",
    "packages",
    "memory",
    "disk",
    {
      "type": "localip",
      "showIpv6": false
    }
  ]
}